rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 0. SEGURIDAD GLOBAL: Denegar todo por defecto
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. AYUDANTES (Helpers) Y VALIDACIONES
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    // El administrador es el usuario con el email del propietario verificado
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'zenhogar2050@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    // Validador de IDs
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // VALIDACIÓN DE ESQUEMA PARA PEDIDOS (Hardened)
    function isValidOrder(data) {
      return data.keys().hasAll(['customer', 'status', 'type']) &&
             data.customer is map &&
             // Validación de campos obligatorios
             (data.customer.get('fullName', data.customer.get('nombre', '')) is string) &&
             (data.customer.get('phone', data.customer.get('telefono', '')) is string) &&
             // Validación de tipos y estados (Actualizado con nuevos estados)
             data.status in [
               'pending', 'confirmed', 'ready_to_ship', 'shipped_with_guide', 
               'in_transit', 'delivered', 'completed', 'waiting_delivery', 
               'declined', 'cancelled', 'with_issue', 'abandoned'
             ] &&
             data.type in ['order', 'abandoned'] &&
             // Límites de tamaño para prevenir ataques
             data.customer.get('phone', data.customer.get('telefono', '')).size() < 20 &&
             data.customer.get('fullName', data.customer.get('nombre', '')).size() < 100;
    }

    // -------------------------------------------------------------------------
    // 2. COLECCIÓN DE PEDIDOS (orders)
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      
      // CREATE: Permitimos que el Checkout público envíe datos
      allow create: if isValidId(orderId) && 
                      isValidOrder(request.resource.data) &&
                      (request.resource.data.status in ['pending', 'abandoned']) &&
                      request.resource.data.created_at == request.time;

      // READ/LIST: Acceso simplificado para indexación y dashboard
      allow read, list: if true; 

      // UPDATE: Permitimos transición de abandoned a pending en Checkout Público
      // Y gestión completa para administrador
      allow update: if (
        // Caso 1: Usuario completando su compra (de abandoned a pending)
        (!isSignedIn() && 
         resource.data.status == 'abandoned' && 
         request.resource.data.status == 'pending' &&
         isValidOrder(request.resource.data)) ||
        
        // Caso 2: Usuario actualizando sus datos de carritos abandonados
        (!isSignedIn() &&
         resource.data.status == 'abandoned' &&
         request.resource.data.status == 'abandoned' &&
         isValidOrder(request.resource.data)) ||

        // Caso 3: Administrador
        isAdmin()
      );
      
      allow delete: if isAdmin(); 
    }
  }
}
