{
  "entities": {
    "Order": {
      "title": "Pedido",
      "description": "Información de pedidos y carritos abandonados",
      "type": "object",
      "properties": {
        "customer": { "type": "object" },
        "order_details": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "ticket_number": { "type": "string" },
        "type": { "enum": ["order", "abandoned"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["customer", "type"]
    },
    "Setting": {
      "title": "Configuración",
      "description": "Configuraciones globales del sistema",
      "type": "object",
      "properties": {
        "lastOrderNumber": { "type": "number" }
      }
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Colección principal de pedidos y prospectos"
    },
    "settings/counters": {
      "schema": "Setting",
      "description": "Documento único para contadores atómicos"
    }
  }
}
